 "phrases": [
  {
   "scene": 0,
   "text": "Ele gastou mil dólares em anúncios e recebeu mil e trezentos.",
   "start": 0.122,
   "end": 4.245
  },
  {
   "scene": 0,
   "text": "Lucro de cento e trinta por cento?",
   "start": 5.069,
   "end": 6.889
  },
  {
   "scene": 0,
   "text": "Não.",
   "start": 7.445,
   "end": 7.79
  },
  {
   "scene": 1,
   "text": "Mil e trezentos sobre mil é o ROAS.",
   "start": 8.446,
   "end": 11.259
  },
  {
   "scene": 1,
   "text": "Mede o retorno bruto,",
   "start": 11.961,
   "end": 13.425
  },
  {
   "scene": 1,
   "text": "não o lucro.",
   "start": 13.899,
   "end": 14.739
  },
  {
   "scene": 2,
   "text": "O lucro é trezentos.",
   "start": 15.494,
   "end": 17.425
  },
  {
   "scene": 2,
   "text": "Trezentos sobre mil:",
   "start": 18.105,
   "end": 19.242
  },
  {
   "scene": 2,
   "text": "ROI de trinta por cento.",
   "start": 19.979,
   "end": 21.689
  },
  {
   "scene": 3,
   "text": "ROAS não é lucro.",
   "start": 22.457,
   "end": 24.085
  },
  {
   "scene": 3,
   "text": "Segue,",
   "start": 24.709,
   "end": 25.253
  },
  {
   "scene": 3,
   "text": "pra não se enganar com o painel.",
   "start": 25.915,
   "end": 27.481
  }
